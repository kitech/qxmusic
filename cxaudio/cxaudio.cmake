# cxaudio source/include manifest (mirrors qlmusic/audio.pri; keep the two in sync).

set(CXAUDIO_DIR ${CMAKE_CURRENT_LIST_DIR})
set(CXAUDIO_THIRD_PARTY ${CXAUDIO_DIR}/../third_party)

set(CXAUDIO_INCLUDE_DIRS
    ${CXAUDIO_DIR}/include
    ${CXAUDIO_THIRD_PARTY}/miniaudio
    ${CXAUDIO_THIRD_PARTY}/stb
    ${CXAUDIO_THIRD_PARTY}/minimp4
    ${CXAUDIO_THIRD_PARTY}/faad2/include
    ${CXAUDIO_THIRD_PARTY}/faad2/libfaad
    ${CXAUDIO_THIRD_PARTY}/mpv/include
)

file(GLOB CXAUDIO_CORE_SOURCES CONFIGURE_DEPENDS ${CXAUDIO_DIR}/src/*.cpp)
file(GLOB CXAUDIO_C_SOURCES CONFIGURE_DEPENDS ${CXAUDIO_DIR}/src/*.c)
file(GLOB CXAUDIO_FAAD_SOURCES CONFIGURE_DEPENDS
    ${CXAUDIO_THIRD_PARTY}/faad2/libfaad/*.c)

set(CXAUDIO_SOURCES
    ${CXAUDIO_CORE_SOURCES}
    ${CXAUDIO_C_SOURCES}
    ${CXAUDIO_FAAD_SOURCES}
)

set(CXAUDIO_FAAD_DEFINES
    HAVE_INTTYPES_H=1
    HAVE_MEMCPY=1
    HAVE_STRING_H=1
    HAVE_STRINGS_H=1
    HAVE_SYS_STAT_H=1
    HAVE_SYS_TYPES_H=1
    HAVE_LRINTF=1
    APPLY_DRC
    PACKAGE_VERSION="2.11.3"
)
